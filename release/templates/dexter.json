{
    "version": "{{tag}}",
    "description": "Interactive dependency explorer for Clojure and JVM projects",
    "homepage": "https://github.com/hlship/dexter",
    "license": "Apache-2.0",
    "suggest": {
        "JDK": ["java/temurin-lts-jdk"]
    },
